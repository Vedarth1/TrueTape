# ---- Postgres (owner / superuser) ----
POSTGRES_DB=truetape
POSTGRES_USER=truetape_owner
POSTGRES_PASSWORD=truetape_owner_pw

# ---- Runtime connection: the app role, deliberately NOT the table owner ----
DATABASE_URL=postgresql+psycopg://truetape_app:truetape_app_pw@db:5432/truetape

# ---- Migration connection: the owner role, used only by `flask db upgrade` ----
MIGRATION_DATABASE_URL=postgresql+psycopg://truetape_owner:truetape_owner_pw@db:5432/truetape

FLASK_APP=wsgi:app
FLASK_DEBUG=1
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

AI_PROVIDER=deterministic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=20